# MongoDB connection string (Atlas or self-hosted). Required for reservations, inquiries and the admin panel.
MONGODB_URI=mongodb://127.0.0.1:27017/sangat

# Long random string used to sign admin session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm run create-admin` / `npm run seed` to create the first admin account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=choose-a-strong-password
